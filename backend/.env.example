# Runtime API connection — non-owner role; row-level security applies.
DATABASE_URL=postgres://pulse_app:pulse_app@localhost:5432/pulse

# Migrations (node-pg-migrate) — table owner role; bypasses RLS.
MIGRATION_DATABASE_URL=postgres://pulse_owner:pulse_owner@localhost:5432/pulse

# API port (SPEC: :3001)
PORT=3001

# Allowed CORS origins for the web app (review N-7) — comma-separated list of
# exact origins (no wildcards). Defaults to both local Vite servers, dev
# (:5173) and preview (:4173), when unset.
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Set to "production" to disable POST /api/seed (review E-1); leave unset in
# development.
#NODE_ENV=development
